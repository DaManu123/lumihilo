{
  "name": "lumihilo-desktop",
  "version": "0.2.0-beta.14",
  "private": true,
  "description": "Lumihilo: puzzle de circuitos de luz con dificultad que se adapta al jugador",
  "author": "DaManu123",
  "homepage": "https://github.com/DaManu123/lumihilo",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.damanu.lumihilo",
    "productName": "Lumihilo",
    "copyright": "Copyright © 2026 DaManu123",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "game"
      }
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Lumihilo-${version}-windows-x64-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "lumihilo",
      "category": "Game",
      "synopsis": "Puzzle de circuitos de luz",
      "artifactName": "Lumihilo-${version}-linux-x64.${ext}",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Lumihilo-${version}-linux-x64.${ext}"
    },
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ]
  },
  "desktopName": "lumihilo.desktop"
}
